#!/bin/sh
# Screen locker: i3lock-color with a big clock and an underline typing bar.
# Fingerprint unlock runs alongside when aadd enabled it (AADD_FINGERPRINT).
# Falls back to plain i3lock if i3lock-color isn't installed (Debian/Fedora).
FINGERPRINT=@AADD_FINGERPRINT@
SCALE=@AADD_SCALE@   # display scale %, sizes below were tuned at 160
BLANK='#00000000'
VERIFY='#f9c74fee'
WRONG='#e06c75ee'
TEXT='#eeeeeeee'
UNDERLINE='#eeeeee55'
FONT='FantasqueSansM Nerd Font'
px() { echo $(($1 * SCALE / 160)); }

# no-op if no notification daemon (e.g. dunst) is running
notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send -t 4000 -u low "$1" "$2" 2>/dev/null
}

# i3lock-color reports a version like "2.13.c.5"
if i3lock --version 2>&1 | grep -q '\.c\.'; then
  i3lock --nofork \
    --insidever-color=$BLANK --ringver-color=$VERIFY \
    --insidewrong-color=$BLANK --ringwrong-color=$WRONG \
    --inside-color=$BLANK --ring-color=$BLANK \
    --line-color=$BLANK --separator-color=$BLANK \
    --keyhl-color=$TEXT --bshl-color=$WRONG \
    --bar-indicator --bar-color=$UNDERLINE --bar-pos="ix-$(px 200):iy+$(px 110)" --bar-total-width=$(px 400) \
    --bar-base-width=2 --bar-max-height=4 --bar-count=12 \
    --verif-color=$VERIFY --wrong-color=$WRONG --time-color=$TEXT --date-color=$TEXT --layout-color=$TEXT \
    --time-size=$(px 110) --date-size=$(px 36) --verif-size=$(px 36) --wrong-size=$(px 36) \
    --date-pos="tx:ty+$(px 70)" \
    --time-font="$FONT" --date-font="$FONT" --verif-font="$FONT" --wrong-font="$FONT" --layout-font="$FONT" \
    --blur 12 --clock --indicator \
    --time-str="%H:%M:%S" --date-str="%A, %d %B" &
else
  i3lock --nofork --color=1d1f21 &
fi
LOCKPID=$!

if [ "$FINGERPRINT" = 1 ] && command -v fprintd-verify >/dev/null 2>&1; then
  (
    while kill -0 "$LOCKPID" 2>/dev/null; do
      if fprintd-verify 2>"${XDG_RUNTIME_DIR:-/tmp}/fprintd-lock.log" | grep -q "verify-match"; then
        notify "Nospiedums nolasīts ✓" ""
        kill "$LOCKPID" 2>/dev/null
        break
      fi
      sleep 0.3
    done
  ) &
  WATCHERPID=$!
fi

wait "$LOCKPID" 2>/dev/null
if [ -n "$WATCHERPID" ]; then
  # kill fprintd-verify too, or an orphan keeps the sensor claimed for every later lock
  kill "$WATCHERPID" 2>/dev/null
  pkill -x -u "$(id -u)" fprintd-verify 2>/dev/null
fi
